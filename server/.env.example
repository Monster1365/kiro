# 서버 포트
PORT=8080

# 분석기: mock(규칙 기반 모의 구현) 만 기본 제공. 외부 AI 연동 시 src/analyzer.js 의 Analyzer 인터페이스를 구현해 추가
ANALYZER=mock

# SMS 발송: mock(실제 발송 없음) 만 기본 제공. 실제 사업자 선정 후 src/smsProvider.js 에 구현 추가 (가정)
SMS_PROVIDER=mock

# 실제 사업자/AI 연동 시 비밀키는 서버 환경 변수로만 주입한다. 앱에는 절대 넣지 않는다.
# AI_API_KEY=
# SMS_API_KEY=

# 개발용: true 면 보호자 인증번호를 API 응답에 포함 (운영에서는 반드시 false)
MOCK_EXPOSE_CODE=true

# 보호자 알림 최대 재시도 횟수 / 인증번호 정책
ALERT_MAX_ATTEMPTS=3
VERIFY_CODE_TTL_SEC=300
VERIFY_MAX_TRIES=5
VERIFY_RESEND_COOLDOWN_SEC=60

# 요청 제한 (설치 단위, 분당)
RATE_LIMIT_PER_MIN=30
# 분석 메타데이터(원문 제외) 서버 보관 시간(초)
ANALYSIS_TTL_SEC=3600
